# EasyDeploy panel — rendered from deploy/nginx/panel.conf.template by the installer and
# `edctl set-port`. Do not edit /etc/nginx/easydeploy/panel.conf by hand.

upstream easydeploy_api {
    server unix:@API_SOCKET@;
    keepalive 16;
}

server {
    @LISTEN@
    server_name _;

    ssl_certificate @SSL_CERT@;
    ssl_certificate_key @SSL_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ed_panel:1m;
    ssl_session_timeout 1d;

    # Plain HTTP sent to the TLS port: redirect to HTTPS.
    error_page 497 =301 https://$host:$server_port$request_uri;

    # The API answers 444 for requests that did not pass the security entrance in "drop" mode;
    # turn it into a closed connection (§9.1).
    proxy_intercept_errors on;
    error_page 444 = @ed_drop;
    location @ed_drop {
        return 444;
    }

    client_max_body_size 64m;
    include /etc/nginx/easydeploy/snippets/panel-security-headers.conf;

    # Hashed static assets of the SPA. index.html itself is served by Django so the
    # entrance check also guards the SPA shell.
    location /assets/ {
        root @FRONTEND_DIR@;
        try_files $uri =404;
        access_log off;
        expires 30d;
        include /etc/nginx/easydeploy/snippets/panel-security-headers.conf;
        add_header Cache-Control "public, immutable" always;
    }

    location /ws/ {
        proxy_pass http://easydeploy_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ed_connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://easydeploy_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
