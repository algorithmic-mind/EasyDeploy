{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "easydeploy_agent", "--dev"],
      "port": 7801
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "easydeploy.asgi:application",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "env": { "DJANGO_SETTINGS_MODULE": "easydeploy.settings.dev" },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
