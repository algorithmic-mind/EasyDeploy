# Custom profile: everything comes from command-line options (--apt-mirror, --docker-mirror,
# --pypi-index, --release-url). Values here are the fallbacks.
APT_MIRROR=
DOCKER_APT_URL=https://download.docker.com/linux/ubuntu
DOCKER_GPG_URL=https://download.docker.com/linux/ubuntu/gpg
REGISTRY_MIRRORS=
PYPI_INDEX=https://pypi.org/simple
PYTHON_DOWNLOAD_MIRROR=
RELEASE_URL=https://github.com/algorithmic-mind/EasyDeploy/releases
