# Profile for networks in Iran (§11). The OWNER maintains these values: fill in mirrors you
# trust and have verified. Empty values fall back to the official sources.
# Do not hardcode third-party mirror URLs anywhere else in the code.
APT_MIRROR=
DOCKER_APT_URL=https://download.docker.com/linux/ubuntu
DOCKER_GPG_URL=https://download.docker.com/linux/ubuntu/gpg
# Comma-separated Docker registry mirrors, e.g. https://registry-mirror.example
REGISTRY_MIRRORS=
PYPI_INDEX=https://pypi.org/simple
PYTHON_DOWNLOAD_MIRROR=
RELEASE_URL=https://get.easydeploy.example/releases
