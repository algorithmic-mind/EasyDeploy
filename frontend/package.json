{
  "name": "easydeploy-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,vue,json,scss}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,json,scss}\"",
    "gen:api": "openapi-typescript openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "^1.13.1",
    "dayjs": "^1.11.13",
    "jalaliday": "^2.3.0",
    "pinia": "^3.0.3",
    "vazirmatn": "^33.0.3",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.9",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.0.1",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.0",
    "eslint-plugin-vue": "^10.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "postcss": "^8.5.6",
    "postcss-rtlcss": "^5.7.1",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.89.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
